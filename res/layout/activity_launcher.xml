<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101923">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="14dp"
        android:paddingRight="18dp"
        android:paddingBottom="12dp"
        android:background="#EE1C2B39">
        <TextView
            android:id="@+id/header_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/srceng_app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:contentDescription="@string/srceng_app_name" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/srceng_library_header_subtitle"
            android:textColor="#FF9FD8D4"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:background="#EE1C2B39">
        <ProgressBar
            android:id="@+id/launcher_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:visibility="gone"
            android:contentDescription="@string/srceng_library_launching" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/button_about"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/srceng_launcher_about"
                android:textColor="#FFFFFFFF" />
            <Button
                android:id="@+id/button_launch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/srceng_launcher_launch"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/footer"
        android:layout_below="@id/header"
        android:orientation="vertical"
        android:padding="8dp">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">
                <Button
                    android:id="@+id/button_advanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/srceng_library_advanced"
                    android:contentDescription="@string/srceng_library_advanced" />
                <LinearLayout
                    android:id="@+id/advanced_panel"
                    android:tag="advanced_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="#FF202B38">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/srceng_launcher_command_args"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />
                    <EditText
                        android:id="@+id/edit_cmdline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:maxLines="2"
                        android:inputType="text"
                        android:text="-console"
                        android:hint="@string/srceng_launcher_command_args"
                        android:backgroundTint="@color/hl_color"
                        android:importantForAutofill="no" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/srceng_launcher_env"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />
                    <EditText
                        android:id="@+id/edit_env"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:maxLines="3"
                        android:inputType="textMultiLine"
                        android:text="LIBGL_USEVBO=0"
                        android:hint="@string/srceng_launcher_env"
                        android:backgroundTint="@color/hl_color"
                        android:importantForAutofill="no" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/srceng_launcher_game_path"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />
                    <EditText
                        android:id="@+id/edit_gamepath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:maxLines="2"
                        android:inputType="textUri"
                        android:text="/sdcard/srceng/"
                        android:hint="@string/srceng_launcher_game_path"
                        android:backgroundTint="@color/hl_color"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</RelativeLayout>
